+void FingerprintAuthenticator::armWatchdog() {
+  m_watchdogTimer.start(kVerifyWatchdog, [this]() {
+    if (!m_active || m_sleeping) {
+      return;
+    }
+    // No result and no error for a whole period: the daemon may have died
+    // silently mid-verify. Light re-arm; any failure consumes the retry budget.
+    kLog.debug("fingerprint watchdog fired; re-arming verification");
+    stopVerify();
+    startVerify(false);
+  });
+}
+
+void FingerprintAuthenticator::scheduleStartRetry() {
+  if (!m_active || m_sleeping || m_abort) {
+    return;
+  }
+  if (m_startAttempts >= kStartMaxAttempts) {
+    kLog.info("fingerprint start retries exhausted; giving up for this session");
+    m_abort = true;
+    emitStatus({}, false); // issue loading: drop the status message
+    return;
+  }
+  m_startAttempts++;
+  m_retryTimer.start(kStartRetryDelay, [this]() {
+    // Recreate the proxy: the daemon may have restarted (new bus owner) or the
+    // device may have re-enumerated (new object path) while we were waiting.
+    m_device.reset();
+    startVerify(false);
+  });
+}
