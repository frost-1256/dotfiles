+/// The frontend that is allowed to drive this backend. Anyone on the session
+/// bus can call the impl interface directly and claim any app id, so only the
+/// current owner of this name is trusted.
+const FRONTEND: &str = "org.freedesktop.portal.Desktop";
+/// Comma separated app ids allowed to open a session. Unset allows everyone.
+const ALLOWED_ENV: &str = "VIRTINPUT_ALLOWED_APP_IDS";
+
 struct Session {
     started: bool,
     persist_mode: u32,
+    /// Unique bus name of the frontend connection that created the session.
+    owner: String,
+}
+
+fn sender_of(header: &Header<'_>) -> String {
+    header
+        .sender()
+        .map(|name| name.to_string())
+        .unwrap_or_default()
+}
+
+fn app_id_allowed(app_id: &str) -> bool {
+    match std::env::var(ALLOWED_ENV) {
+        Ok(list) => list
+            .split(',')
+            .map(str::trim)
+            .any(|allowed| !allowed.is_empty() && allowed == app_id),
+        Err(_) => true,
+    }
 }
 
