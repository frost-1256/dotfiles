+//! Kernel uinput keyboard.
+//!
+//! `zwp_virtual_keyboard_v1` input is delivered straight to the focused
+//! client on niri, so compositor bindings and input methods never see it.
+//! A uinput device goes through libinput like a physical keyboard instead.
+
+use std::ffi::{c_int, c_ulong};
+use std::fs::{File, OpenOptions};
+use std::io::{self, Write};
+use std::os::fd::AsRawFd;
+use std::os::unix::fs::OpenOptionsExt;
+
+unsafe extern "C" {
+    fn ioctl(fd: c_int, request: c_ulong, ...) -> c_int;
+}
+
+const UI_DEV_CREATE: c_ulong = 0x5501;
+const UI_DEV_DESTROY: c_ulong = 0x5502;
+const UI_DEV_SETUP: c_ulong = 0x405c_5503;
+const UI_SET_EVBIT: c_ulong = 0x4004_5564;
+const UI_SET_KEYBIT: c_ulong = 0x4004_5565;
+
+const EV_SYN: u16 = 0x00;
+const EV_KEY: u16 = 0x01;
+const SYN_REPORT: u16 = 0;
+const BUS_VIRTUAL: u16 = 0x06;
+// Keyboard keys only (KEY_ESC..KEY_MICMUTE). Staying below BTN_MISC keeps
+// libinput from classifying the device as a pointer.
+const KEY_FIRST: c_int = 1;
+const KEY_LAST: c_int = 248;
+
+#[repr(C)]
+struct InputId {
+    bustype: u16,
+    vendor: u16,
+    product: u16,
+    version: u16,
+}
+
+#[repr(C)]
+struct UinputSetup {
+    id: InputId,
+    name: [u8; 80],
+    ff_effects_max: u32,
+}
+
+#[repr(C)]
+struct InputEvent {
+    sec: i64,
+    usec: i64,
+    kind: u16,
+    code: u16,
+    value: i32,
+}
+
+pub struct UinputKeyboard {
+    file: File,
+}
+
+fn check(ret: c_int) -> io::Result<()> {
+    if ret < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+impl UinputKeyboard {
+    pub fn new() -> io::Result<Self> {
+        let file = OpenOptions::new()
+            .write(true)
+            .custom_flags(0o4000) // O_NONBLOCK
+            .open("/dev/uinput")?;
+        let fd = file.as_raw_fd();
+        let mut setup = UinputSetup {
+            id: InputId {
+                bustype: BUS_VIRTUAL,
+                vendor: 0x1209,
+                product: 0x5649,
+                version: 1,
+            },
+            name: [0; 80],
+            ff_effects_max: 0,
+        };
+        let name = b"virtinput-portal keyboard";
+        setup.name[..name.len()].copy_from_slice(name);
+        // SAFETY: fd is an open uinput descriptor and every argument matches
+        // the type the request expects.
+        unsafe {
+            check(ioctl(fd, UI_SET_EVBIT, EV_KEY as c_int))?;
+            check(ioctl(fd, UI_SET_EVBIT, EV_SYN as c_int))?;
+            for key in KEY_FIRST..=KEY_LAST {
+                check(ioctl(fd, UI_SET_KEYBIT, key))?;
+            }
+            check(ioctl(fd, UI_DEV_SETUP, &setup as *const UinputSetup))?;
+            check(ioctl(fd, UI_DEV_CREATE))?;
+        }
+        Ok(Self { file })
+    }
+
+    fn emit(&mut self, kind: u16, code: u16, value: i32) -> io::Result<()> {
+        let event = InputEvent {
+            sec: 0,
+            usec: 0,
+            kind,
+            code,
+            value,
+        };
+        // SAFETY: InputEvent is a plain repr(C) struct matching struct input_event.
+        let bytes = unsafe {
+            std::slice::from_raw_parts(
+                (&event as *const InputEvent).cast::<u8>(),
+                std::mem::size_of::<InputEvent>(),
+            )
+        };
+        self.file.write_all(bytes)
+    }
+
+    pub fn key(&mut self, keycode: u32, pressed: bool) -> io::Result<()> {
+        let Ok(code) = u16::try_from(keycode) else {
+            return Ok(());
+        };
+        self.emit(EV_KEY, code, i32::from(pressed))?;
+        self.emit(EV_SYN, SYN_REPORT, 0)
+    }
+}
+
+impl Drop for UinputKeyboard {
+    fn drop(&mut self) {
+        // SAFETY: fd is still open; destroying an already gone device is harmless.
+        unsafe {
+            ioctl(self.file.as_raw_fd(), UI_DEV_DESTROY);
+        }
+    }
+}
